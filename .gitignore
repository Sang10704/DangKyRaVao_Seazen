# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Node.js dependencies (Frontend build artifacts in ui/frontend/dist are tracked for instant execution)
ui/frontend/node_modules/
node_modules/

# Runtime browser profile, live caches & sensitive token files
data/.webview_profile/
data/.cache/
data/pending_visitors.json
data/master_employees_sp_cache.json
token_cache.bin
sp_cookies.json

# Temporary exported Excel reports & scratch files
data/*.xlsx
scratch/
*.log
*.log.*
logs/
*.tmp
